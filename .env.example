# web-gui-for-aka-only-server の設定。このファイルを .env にコピーして書き換え、パーミッションを 600 にする。

# ---- 構成 ----

# aka-only-server と同じホストで動かす場合は、共有ネットワークに参加する設定を重ねる（既定）。
# 別のホストで動かす場合は compose.yaml だけにして、WEBGUI_ADMIN_URL を書き換える。
COMPOSE_FILE=compose.yaml:compose.aka-av.yaml
# 同一ホストの aka-only-server が作る共有ネットワークの名前（aka-only-server 側の AKA_SHARED_NETWORK と同じにする）。
AKA_SHARED_NETWORK=aka-av

# aka-only-server の管理API。同一ホストなら既定のままでよい。
# 別ホストの場合は、管理API のサーバー証明書の SAN（aka-only-server 側の AKA_ADMIN_TLS_HOSTS）に入っている名前か IP アドレスで指定する。
WEBGUI_ADMIN_URL=https://aka-only-server:9443/admin/v1

# ---- 必須 ----

# BFF 専用の Valkey のパスワード。
VALKEY_PASSWORD=change-me

# 最初の管理者。ここを常に正とし、Valkey には保存しない。
# パスワードを変えるときは、ここを書き換えて起動し直す（ログイン中のセッションは無効になる）。
# ユーザーID は英数字と . _ @ - の 64 文字まで。パスワードは 8 文字以上。
WEBGUI_INITIAL_ADMIN_ID=admin
WEBGUI_INITIAL_ADMIN_PASSWORD=

# ---- ブラウザ向け HTTPS ----

# 公開するホスト側のアドレスとポート。VPN 側のアドレス（Tailscale なら 100.x.y.z）に限定する。
WEBGUI_PUBLISH=127.0.0.1:8444

# 自己署名のサーバー証明書を初回起動時に自動生成するとき、SAN に入れるホスト名と IP アドレス。
# ブラウザで開くときの名前や IP アドレスをカンマ区切りで指定する。生成済みの証明書には反映されない。
WEBGUI_TLS_HOSTS=localhost,127.0.0.1

# 持ち込みの証明書を使う場合は、certs/ に置いてコンテナ内のパス（/certs/...）を指定する。
# 空なら自己署名（/data/tls/ に自動生成）を使う。
WEBGUI_TLS_CERT=
WEBGUI_TLS_KEY=

# ---- セッションとログインの制限 ----

WEBGUI_SESSION_IDLE_TIMEOUT=30m
WEBGUI_SESSION_MAX_AGE=12h
WEBGUI_LOGIN_MAX_FAILURES=5
WEBGUI_LOGIN_LOCK_DURATION=15m

# ---- その他 ----

TZ=Asia/Tokyo
WEBGUI_LOG_LEVEL=info
WEBGUI_AUDIT_MAX=10000
